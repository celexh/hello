function UI:GetColorChannel255(value)
    local numberValue = tonumber(value) or 0
    if numberValue <= 1.001 then
        return math.floor((numberValue * 255) + 0.5)
    end
    return math.floor(numberValue + 0.5)
end

function UI:IsButtonColorActive(button)
    if not button or not button:IsA("BasePart") then
