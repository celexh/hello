function UI:ParseCompactNumber(text)
    local raw = tostring(text or ""):gsub("%s+", "")
    local multiplier = 1
    local suffix = raw:sub(-1):upper()

    if suffix == "K" then
        multiplier = 1000
        raw = raw:sub(1, -2)
    elseif suffix == "M" then
        multiplier = 1000000
        raw = raw:sub(1, -2)
    elseif suffix == "B" then
        multiplier = 1000000000
        raw = raw:sub(1, -2)
    end

    raw = raw:gsub("[^%d%.%-]", "")
    local value = tonumber(raw)
    if not value then
        return 0
    end

    return math.floor((value * multiplier) + 0.5)
end

