function WalkToService.WalkTo(humanoid, targetPosition)
    if not humanoid or not humanoid.Address or typeof(targetPosition) ~= "Vector3" then
        return false
    end

    local character = humanoid.Parent
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then
        return false
    end

    WalkToService.humanoid = humanoid
    WalkToService.character = character
    WalkToService.currentTarget = targetPosition
    WalkToService.startedAt = tick()
    WalkToService.isWalking = true

    local function writeWalkTarget()
        local currentRoot = WalkToService.character and WalkToService.character:FindFirstChild("HumanoidRootPart")
        if not currentRoot then
            return false
        end

        local delta = WalkToService.currentTarget - currentRoot.Position
        local distance = delta.Magnitude
        if distance <= WALK_STOP_DISTANCE then
            MoveDebug(string.format(
                "Walk stop distance=%.2f target=(%.2f, %.2f, %.2f) pos=(%.2f, %.2f, %.2f)",
                distance,
                WalkToService.currentTarget.X,
                WalkToService.currentTarget.Y,
                WalkToService.currentTarget.Z,
                currentRoot.Position.X,
                currentRoot.Position.Y,
                currentRoot.Position.Z
            ))
            WalkToService.Stop()
            return false
        end

        local direction = delta.Unit
        local humAddress = WalkToService.humanoid and WalkToService.humanoid.Address
        if not humAddress then
            WalkToService.Stop()
            return false
        end

        WriteVector3(humAddress, WALKTOPOINT_OFFSET_1, WalkToService.currentTarget)
        WriteVector3(humAddress, DIRECTION_OFFSET, direction)
        WriteVector3(humAddress, WALKTOPOINT_OFFSET_2, WalkToService.currentTarget)
        return true
    end

    if not writeWalkTarget() then
        return false
    end

    WalkToService.updateThread = task.spawn(function()
        while WalkToService.isWalking do
            if not writeWalkTarget() then
                break
            end
            task.wait(0.1)
        end
    end)

    return true
end

function WalkToService.Stop()
    WalkToService.isWalking = false

    if WalkToService.humanoid and WalkToService.humanoid.Address then
        local humAddress = WalkToService.humanoid.Address
        local zero = Vector3.new(0, 0, 0)
        WriteVector3(humAddress, WALKTOPOINT_OFFSET_1, zero)
        WriteVector3(humAddress, DIRECTION_OFFSET, zero)
        WriteVector3(humAddress, WALKTOPOINT_OFFSET_2, zero)
    end

    WalkToService.currentTarget = nil
    WalkToService.startedAt = 0
    WalkToService.updateThread = nil
end

