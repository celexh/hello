function UI:GetButtonTeleportTarget(option)
    local plot = self:GetOwnedPlot()
    local buttons = plot and plot:FindFirstChild("Buttons")
    if not buttons then
        return nil
    end

    local buttonMap = {
        ["Buy 1"] = {"ButtonBuy1", "Button"},
        ["Buy 5"] = {"ButtonBuy5", "Button"},
        ["Buy 25"] = {"ButtonBuy25", "Button"},
        ["Buy 100"] = {"ButtonBuy100", "Button"},
        ["Merge"] = {"ButtonMerge", "Button"},
    }

    local path = buttonMap[option]
    if not path then
        return nil
    end

    local current = buttons
    for _, childName in ipairs(path) do
        current = current and current:FindFirstChild(childName)
    end

    return current and current:IsA("BasePart") and current or nil
end

function UI:GetSellTeleportTarget(buttonName)
    local plot = self:GetOwnedPlot()
    local sell = plot and plot:FindFirstChild("Sell")
    local parentButton = sell and sell:FindFirstChild(buttonName)
    local button = parentButton and parentButton:FindFirstChild("Button")
    return button and button:IsA("BasePart") and button or nil
end

function UI:GetFarmAreaPosition()
    local plot = self:GetOwnedPlot()
    local troughPart = plot and plot:FindFirstChild("TroughPart")
    if troughPart and troughPart:IsA("BasePart") then
        return troughPart.Position
    end
    return nil
