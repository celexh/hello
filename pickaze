function UI:StartFarmAction(actionId, targetPart)
    if not targetPart or not targetPart:IsA("BasePart") then
        return false
    end

    local rootPart = self:GetLocalRootPart()
    local farmAreaPosition = self:GetFarmAreaPosition()
    if not rootPart or not farmAreaPosition then
        return false
    end

    self:CancelMovement()

    local targetPosition = targetPart.Position
    local distance = (targetPosition - rootPart.Position).Magnitude

    self.farmActionState = {
        id = actionId,
        targetPosition = targetPosition,
        returnPosition = farmAreaPosition,
        phase = "to_target",
        startedAt = tick(),
    }

    if actionId == "collect_money" then
        self:TeleportToPart(targetPart)
        self.farmActionState.phase = "wait_return"
        self.farmActionState.returnAt = tick() + 0.2
    elseif distance > 40 then
        self:TeleportToPart(targetPart)
        self.farmActionState.phase = "wait_return"
        self.farmActionState.returnAt = tick() + 0.4
    else
        self:WalkToPosition(targetPosition)
    end

    return true
end

function UI:UpdateFarmAction()
    local action = self.farmActionState
    if not action then
        return false
    end

    local rootPart = self:GetLocalRootPart()
    if not rootPart then
        self.farmActionState = nil
        return false
    end

    if action.phase == "to_target" then
        if (rootPart.Position - action.targetPosition).Magnitude <= 3 then
            self:CancelMovement()
            action.phase = "wait_return"
            action.returnAt = tick() + 0.35
        elseif tick() - (action.startedAt or tick()) >= 5 then
            self:TeleportToPosition(action.targetPosition, 8)
            self:CancelMovement()
            action.phase = "wait_return"
            action.returnAt = tick() + 0.2
        end
        return true
    end

    if action.phase == "wait_return" then
        if tick() >= (action.returnAt or 0) then
            self:CancelMovement()
            if action.id == "collect_money" then
                self:TeleportToPosition(action.returnPosition, 3)
                self.farmActionState = nil
            else
                local returnDistance = (action.returnPosition - rootPart.Position).Magnitude
                if returnDistance > 40 then
                    self:TeleportToPosition(action.returnPosition, 3)
                    self.farmActionState = nil
                else
                    action.returnStartedAt = tick()
                    self:WalkToPosition(action.returnPosition)
                    action.phase = "to_return"
                end
            end
        end
        return true
    end

    if action.phase == "to_return" then
        if (rootPart.Position - action.returnPosition).Magnitude <= 4 then
            self:CancelMovement()
            self.farmActionState = nil
        elseif tick() - (action.returnStartedAt or tick()) >= 5 then
            self:TeleportToPosition(action.returnPosition, 3)
            self:CancelMovement()
            self.farmActionState = nil
        end
        return true
    end

    self.farmActionState = nil
    return false
end

function UI:HandleAutoMerge()
    if not self:IsFarmEnabled() or not self:IsAutoMergeEnabled() then
        return
    end

    local mergeButton = self:GetMergeButtonPart()
    local rootPart = self:GetLocalRootPart()
    if not mergeButton or not rootPart then
        return
    end

    if not self:IsMergePossible() then
        return
    end

    local mergePosition = mergeButton.Position
    local distance = (mergePosition - rootPart.Position).Magnitude

    if distance <= BUTTON_ARRIVAL_DISTANCE then
        self:CancelMovement()
        MoveDebug(string.format("AutoMerge arrived distance=%.2f", distance))
        return
    end

    if distance > 40 then
        self:CancelMovement()
        self:TeleportToPart(mergeButton)
        return
    end

    if self:IsWalking() then
        local currentTarget = WalkToService.currentTarget
        if currentTarget and (currentTarget - mergePosition).Magnitude <= 3 then
            local startedAt = WalkToService.startedAt or tick()
            if tick() - startedAt >= 5 then
                MoveDebug("AutoMerge timeout -> teleport")
                self:TeleportToPart(mergeButton)
            end
            return
        end
    end

    self:CancelMovement()
    self:WalkToPosition(mergePosition)
end

function UI:HandleAutoBuyPickaxe()
    if not self:IsFarmEnabled() or not self:IsAutoBuyPickaxeEnabled() or self:ShouldPrioritizeAutoMerge() then
        return
    end

    if self:IsAutoBuyCooldownActive() then
        return
    end

    local rootPart = self:GetLocalRootPart()
    if not rootPart then
        return
    end

    local buyButton = nil
    for _, entry in ipairs(self:GetAutoBuyButtonParts()) do
        if self:IsButtonColorActive(entry.button) then
            buyButton = entry.button
            break
        end
    end

    if not buyButton then
        return
    end

    local buyPosition = buyButton.Position
    local distance = (buyPosition - rootPart.Position).Magnitude

    if distance <= BUTTON_ARRIVAL_DISTANCE then
        self.lastAutoBuyTick = tick()
        self:CancelMovement()
        MoveDebug(string.format(
            "AutoBuy arrived distance=%.2f cooldownStart=2.00 selected=%s",
            distance,
            tostring(buyButton.Parent and buyButton.Parent.Name or buyButton.Name)
        ))

        local farmAreaPosition = self:GetFarmAreaPosition()
        if farmAreaPosition and (farmAreaPosition - rootPart.Position).Magnitude > 6 then
            self:WalkToPosition(farmAreaPosition)
        end
        return
    end

    if self:IsWalking() then
        local currentTarget = WalkToService.currentTarget
        if currentTarget and (currentTarget - buyPosition).Magnitude <= 3 then
            local startedAt = WalkToService.startedAt or tick()
            if tick() - startedAt >= 5 then
                MoveDebug(string.format(
                    "AutoBuy timeout -> teleport selected=%s distance=%.2f",
                    tostring(buyButton.Parent and buyButton.Parent.Name or buyButton.Name),
                    distance
                ))
                self:TeleportToPart(buyButton)
            end
            return
        end
    end

    MoveDebug(string.format(
        "AutoBuy walking selected=%s distance=%.2f target=(%.2f, %.2f, %.2f) pos=(%.2f, %.2f, %.2f)",
        tostring(buyButton.Parent and buyButton.Parent.Name or buyButton.Name),
        distance,
        buyPosition.X,
        buyPosition.Y,
        buyPosition.Z,
        rootPart.Position.X,
        rootPart.Position.Y,
        rootPart.Position.Z
    ))
    self:CancelMovement()
    self:WalkToPosition(buyPosition)
end

function UI:HandleFarmSellActions(collectableOres)
    if self:ShouldPrioritizeAutoMerge() or self:ShouldPrioritizeAutoBuyPickaxe() then
        return true
    end

    if self:UpdateFarmAction() then
        return true
    end

    local rootPart = self:GetLocalRootPart()
    if not rootPart then
        return false
    end

    local now = tick()

    if self:IsAutoCollectMoneyEnabled() and (now - (self.lastCollectMoneyTick or 0)) >= self:GetCollectMoneyInterval() then
        local collectButton = self:GetSellTeleportTarget("CollectButton")
        if self:StartFarmAction("collect_money", collectButton) then
            self.lastCollectMoneyTick = now
            return true
        end
    end

    local amountEnabled = self:IsDepositAtAmountEnabled()
    local intervalEnabled = self:IsDepositIntervalEnabled()
    local multiplierEnabled = self:IsDepositMultiplierEnabled()
    local anyDepositConditionEnabled = amountEnabled or intervalEnabled or multiplierEnabled

    local shouldDepositByAmount = (not amountEnabled)
        or self:GetCurrentOreAmount() >= self:GetDepositThreshold()
    local shouldDepositByInterval = (not intervalEnabled)
        or (now - (self.lastDepositOreTick or 0)) >= self:GetDepositIntervalSeconds()
    local shouldDepositByMultiplier = (not multiplierEnabled)
        or self:GetCurrentDepositMultiplier() >= self:GetDepositMultiplierThreshold()
    local depositCooldownPassed = (now - (self.lastDepositOreTick or 0)) >= self:GetDepositCooldownSeconds()

    if (not collectableOres or #collectableOres <= 0)
        and self:IsAutoDepositOreEnabled()
        and (not anyDepositConditionEnabled or (
            shouldDepositByAmount
            and shouldDepositByInterval
            and shouldDepositByMultiplier
        ))
        and depositCooldownPassed
    then
        local depositButton = self:GetSellTeleportTarget("DepositButton")
        if self:StartFarmAction("deposit_ore", depositButton) then
            self.lastDepositOreTick = now
            return true
        end
    end

    return false
end

function UI:HandleCollectOres()
    if not self:IsFarmEnabled() then
        self:CancelMovement()
        self.farmActionState = nil
        return
    end

    if self:ShouldPrioritizeAutoMerge() then
        return
    end

    if self:ShouldPrioritizeAutoBuyPickaxe() then
        return
    end

    if self:HandleFarmSellActions(nil) then
        return
    end

    local rootPart = self:GetLocalRootPart()
    if not rootPart then
        OreDebug("Collect Ores skipped: no HumanoidRootPart")
        return
    end

    local ores = self:GetOreInstances()
    if self:HandleFarmSellActions(ores) then
        return
    end

    if #ores <= 0 then
        OreDebug("Collect Ores skipped: no collectable ores inside trough")
        return
    end

    local closestOre = nil
    local closestPosition = nil
    local closestDistance = math.huge

    for _, ore in ipairs(ores) do
        local targetPosition = self:GetInstanceTargetPosition(ore)
        if targetPosition then
            local distance = (targetPosition - rootPart.Position).Magnitude
            if distance < closestDistance then
                closestDistance = distance
                closestOre = ore
                closestPosition = targetPosition
            end
        end
    end

    if not closestOre or not closestPosition then
        OreDebug("Collect Ores skipped: no valid ore positions")
        self:StopWalking()
        return
    end

    OreDebug(string.format(
        "Collect Ores target=%s distance=%.2f playerPos=(%.2f, %.2f, %.2f) orePos=(%.2f, %.2f, %.2f)",
        tostring(closestOre.Name),
        closestDistance,
        rootPart.Position.X,
        rootPart.Position.Y,
        rootPart.Position.Z,
        closestPosition.X,
        closestPosition.Y,
        closestPosition.Z
    ))

    if closestDistance > 40 then
        self:StopWalking()
        local closePosition = closestPosition + Vector3.new(0, 3, 0)
        OreDebug(string.format(
            "Collect Ores tweening close target=(%.2f, %.2f, %.2f)",
            closePosition.X,
            closePosition.Y,
            closePosition.Z
        ))
        self:TweenToPosition(closePosition)
        return
    end

    if self:IsWalking() then
        local currentTarget = WalkToService.currentTarget
        if currentTarget and (currentTarget - closestPosition).Magnitude <= 3 then
            local startedAt = WalkToService.startedAt or tick()
            if tick() - startedAt >= 5 then
                self:TeleportToPosition(closestPosition, 3)
            end
            OreDebug("Collect Ores skipped: already walking to current target")
            return
        end
    end

    OreDebug(string.format(
        "Collect Ores walking target=(%.2f, %.2f, %.2f)",
        closestPosition.X,
        closestPosition.Y,
        closestPosition.Z
    ))
    self:WalkToPosition(closestPosition)
end

