local function LerpNumber(a, b, t)
    return a + ((b - a) * t)
end

local function LerpColor(a, b, t)
    return Color3.new(
        LerpNumber(a.R, b.R, t),
        LerpNumber(a.G, b.G, t),
        LerpNumber(a.B, b.B, t)
    )
end

local function SmoothFactor(speed, dt)
    return 1 - math.exp(-(speed or 1) * (dt or (1 / 60)))
end

local function NearlyEqual(a, b, epsilon)
    return math.abs((a or 0) - (b or 0)) <= (epsilon or 0.001)
end

local VK_Z = 0x5A

local function MemoryGetChild(parent, name)
    if not parent or parent == 0 or type(memory_read) ~= "function" then
        return nil
    end

    local childrenPtr = memory_read("uintptr_t", parent + 0x78)
    if not childrenPtr or childrenPtr == 0 then
        return nil
    end

    local startPtr = memory_read("uintptr_t", childrenPtr)
    local endPtr = memory_read("uintptr_t", childrenPtr + 0x8)
    if not startPtr or not endPtr or startPtr == 0 or endPtr == 0 or endPtr <= startPtr then
        return nil
    end

    for i = 0, ((endPtr - startPtr) / 8) - 1 do
        local child = memory_read("uintptr_t", startPtr + (i * 8))
        if child and child ~= 0 then
            local namePtr = memory_read("uintptr_t", child + 0xB0)
            if namePtr and namePtr ~= 0 then
                local childName = memory_read("string", namePtr)
                if childName == name then
                    return child
                end
            end
        end
    end

    return nil
end

function UI:GetLocalUserId()
    if LocalPlayer and tonumber(LocalPlayer.UserId) then
        return tonumber(LocalPlayer.UserId)
    end

    if type(getbase) ~= "function" or type(memory_read) ~= "function" then
        return nil
    end

    local ok, userId = pcall(function()
        local base = getbase()
        local dataModel = memory_read("uintptr_t", memory_read("uintptr_t", base + 0x74f6758) + 0x1D0)
        local players = MemoryGetChild(dataModel, "Players")
        local localPlayer = players and memory_read("uintptr_t", players + 0x138) or nil
        return localPlayer and memory_read("uintptr_t", localPlayer + 0x2D8) or nil
    end)

    if ok and userId and userId ~= 0 then
        return tonumber(userId)
    end

    return nil
end

function UI:GetOwnedPlot()
    local targetUserId = self:GetLocalUserId()
    local plots = workspace and workspace:FindFirstChild("Plots")
    if not targetUserId or not plots then
        local missKey = "missing:" .. tostring(targetUserId)
        if self.ownedPlotLogKey ~= missKey then
            print("Base lookup failed userId=" .. tostring(targetUserId))
            self.ownedPlotLogKey = missKey
        end
        return nil
    end

    for _, plot in ipairs(plots:GetChildren()) do
        local ownerUserId = nil
        local ok = pcall(function()
            ownerUserId = plot:GetAttribute("OwnerUserId")
        end)
        if ok and tonumber(ownerUserId) == tonumber(targetUserId) then
            local foundKey = tostring(plot.Name) .. ":" .. tostring(ownerUserId)
            if self.ownedPlotLogKey ~= foundKey then
                print(string.format(
                    "Found player base: %s (OwnerUserId=%s)",
                    tostring(plot.Name),
                    tostring(ownerUserId)
                ))
                self.ownedPlotLogKey = foundKey
            end
            return plot
        end
    end

    local noneKey = "none:" .. tostring(targetUserId)
    if self.ownedPlotLogKey ~= noneKey then
        print("No player base found for OwnerUserId=" .. tostring(targetUserId))
        self.ownedPlotLogKey = noneKey
    end
    return nil
end

