function UI:EnsureTweenWorker()
    if self.tweenWorkerRunning then
        return
    end

    self.tweenWorkerRunning = true
    task.spawn(function()
        local stepWait = 1 / 120

        while self.isRunning do
            local tweenId = self.activeTweenId or 0
            local targets = self.pendingTweenTargets

            if type(targets) ~= "table" or #targets <= 0 then
                task.wait(0.02)
            else
                local speed = self:GetTweenSpeed()

                for _, targetPosition in ipairs(targets) do
                    if not self.isRunning or self.activeTweenId ~= tweenId then
                        break
                    end

                    if typeof(targetPosition) == "Vector3" then
                        local lastTick = tick()
                        while self.isRunning and self.activeTweenId == tweenId do
                            local currentRoot = self:GetLocalRootPart()
                            if not currentRoot then
                                break
                            end

                            local now = tick()
                            local dt = math.max(stepWait, now - lastTick)
                            lastTick = now

                            local currentPosition = currentRoot.Position
                            local offset = targetPosition - currentPosition
                            local distance = offset.Magnitude
                            if distance <= 2 then
                                currentRoot.CFrame = CFrame.new(targetPosition.X, targetPosition.Y, targetPosition.Z)
                                break
                            end

                            local step = math.min(distance, speed * dt)
                            local nextPosition = currentPosition + (offset.Unit * step)
                            currentRoot.CFrame = CFrame.new(nextPosition.X, nextPosition.Y, nextPosition.Z)
                            task.wait(stepWait)
                        end
                    end
                end

                if self.activeTweenId == tweenId then
                    self.pendingTweenTargets = nil
                end
            end
        end

        self.tweenWorkerRunning = false
    end)
end

function UI:TweenToPosition(targetPosition)
    local rootPart = self:GetLocalRootPart()
    if not rootPart or typeof(targetPosition) ~= "Vector3" then
        return false
    end

    self.activeTweenId = (self.activeTweenId or 0) + 1
    self.pendingTweenTargets = {targetPosition}
    self:EnsureTweenWorker()
    return true
end

function UI:GetOreInstances()
    local plot = self:GetOwnedPlot()
    local troughPart = plot and plot:FindFirstChild("TroughPart")
    local ores = {}

    if not workspace or not troughPart or not troughPart:IsA("BasePart") then
        OreDebug(string.format(
            "Collect Ores missing data plot=%s workspace=%s troughPart=%s",
            tostring(plot and plot.Name or nil),
            tostring(workspace ~= nil),
            tostring(troughPart ~= nil)
        ))
        return ores
    end

    local totalLootCandidates = 0
    for _, child in ipairs(workspace:GetChildren()) do
        if child.Name == "Loot3" or child.Name:match("^Loot%d+$") then
            totalLootCandidates = totalLootCandidates + 1
            if self:IsLootInsideTrough(troughPart, child) then
                ores[#ores + 1] = child
            end
        end
    end

    OreDebug(string.format(
        "Collect Ores scanned plot=%s candidates=%d insideTrough=%d troughPos=(%.2f, %.2f, %.2f) troughSize=(%.2f, %.2f, %.2f)",
        tostring(plot.Name),
        totalLootCandidates,
        #ores,
        troughPart.Position.X,
        troughPart.Position.Y,
        troughPart.Position.Z,
        troughPart.Size.X,
        troughPart.Size.Y,
        troughPart.Size.Z
    ))
    return ores
end

