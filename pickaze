function UI:IsPositionInsideTrough(troughPart, worldPosition)
    if not troughPart or not troughPart:IsA("BasePart") or typeof(worldPosition) ~= "Vector3" then
        return false
    end

    local localPosition = troughPart.CFrame:PointToObjectSpace(worldPosition)
    local halfSize = troughPart.Size * 0.5
    local horizontalAllowanceX = 4
    local horizontalAllowanceZ = 4

    return math.abs(localPosition.X) <= (halfSize.X + horizontalAllowanceX)
        and math.abs(localPosition.Z) <= (halfSize.Z + horizontalAllowanceZ)
end

function UI:IsLootInsideTrough(troughPart, instance)
    if not troughPart or not instance then return false end
    local pos = self:GetInstanceTargetPosition(instance)
    return pos and self:IsPositionInsideTrough(troughPart, pos) or false
end

