function UI:GetBestBloomFieldName()
    local now = os.clock()

    if now - (self.lastBloomFieldCheck or 0) < 0.35 then
        return self.cachedBloomField, self.cachedBloomCount or 0
    end

    self.lastBloomFieldCheck = now

    local fields = self:GetAllBrickFieldNames()
    local counts = {}
    local fieldAreas = {}
    local bloomSizeScores = {}

    for _, fieldName in ipairs(fields) do
        counts[fieldName] = 0
        bloomSizeScores[fieldName] = 0

        local zone = self:GetFlowerZone(fieldName)
        if zone and zone:IsA("BasePart") then
            fieldAreas[fieldName] = (zone.Size.X or 0) * (zone.Size.Z or 0)
        else
            fieldAreas[fieldName] = math.huge
        end
    end

    for _, bloomModel in ipairs(self:GetBrickBloomModels()) do
        local centerPart = bloomModel:FindFirstChild("CenterPart")
        if centerPart and centerPart:IsA("BasePart") then
            local centerPosition = centerPart.Position

            for _, fieldName in ipairs(fields) do
                if self:IsPositionInField(fieldName, centerPosition) then
                    counts[fieldName] = (counts[fieldName] or 0) + 1
                    bloomSizeScores[fieldName] = (bloomSizeScores[fieldName] or 0) + ((centerPart.Size.X or 0) * (centerPart.Size.Z or 0))
                    break
                end
            end
        end
    end

    local bestField = nil
    local bestCount = 0
    local bestBloomSize = math.huge
    local bestArea = math.huge

    for _, fieldName in ipairs(fields) do
        local count = counts[fieldName] or 0
        local area = fieldAreas[fieldName] or math.huge
        local bloomSize = bloomSizeScores[fieldName] or math.huge

        if count > bestCount or (count == bestCount and count > 0 and (bloomSize < bestBloomSize or (bloomSize == bestBloomSize and area < bestArea))) then
            bestField = fieldName
            bestCount = count
            bestBloomSize = bloomSize
            bestArea = area
        end
    end

    if now - (self.lastBloomFieldDebug or 0) >= 1.5 then
        self.lastBloomFieldDebug = now

        local parts = {}
        for _, fieldName in ipairs(fields) do
            table.insert(parts, string.format(
                "%s=%d size=%.1f area=%.0f",
                fieldName,
                counts[fieldName] or 0,
                bloomSizeScores[fieldName] or 0,
                fieldAreas[fieldName] or 0
            ))
        end

        if type(print) == "function" then
            print("[BSS] Farm Flowers Debug: counts {" .. table.concat(parts, ", ") .. "} chosen=" .. tostring(bestField) .. " count=" .. tostring(bestCount) .. " size=" .. tostring(bestBloomSize))
        end
    end

    local oldField = self.cachedBloomField
    local oldCount = self.cachedBloomCount or 1
    local holdTime = self.bloomHoldTime or 15

    if oldField and oldField ~= bestField then
        if self.lastBloomGoneTime == 0 then
            self.lastBloomGoneTime = now
        end

        if (now - self.lastBloomGoneTime) < holdTime then
            return oldField, oldCount
        end

        self.lastBloomGoneTime = 0
        self:InvalidateFarmTarget("flower field changed")
    end

    if bestCount <= 0 then
        if oldField then
            if self.lastBloomGoneTime == 0 then
                self.lastBloomGoneTime = now
            end

            if (now - self.lastBloomGoneTime) < holdTime then
                return oldField, oldCount
            end
        end

        self.cachedBloomField = nil
        self.cachedBloomCount = 0
        self.lastBloomGoneTime = 0
        return nil, 0
    end

    self.lastBloomGoneTime = 0
    self.cachedBloomField = bestField
    self.cachedBloomCount = bestCount
    return bestField, bestCount
end

function UI:GetFarmTargetFieldNames()
