function UI:GetBasePartFromObject(object)
    if not object then
        return nil
    end

    if object:IsA("BasePart") then
        return object
    end

    if object:IsA("Model") and object.PrimaryPart and object.PrimaryPart:IsA("BasePart") then
        return object.PrimaryPart
    end

    for _, descendant in ipairs(object:GetDescendants()) do
        if descendant:IsA("BasePart") then
            return descendant
        end
    end

    return nil
end

function UI:GetOwnedHivePlatform()
    local hivePlatforms = workspace:FindFirstChild("HivePlatforms")
    local playerName = tostring(LocalPlayer and LocalPlayer.Name or "")
    if not hivePlatforms or playerName == "" then
        self:HiveDebug("scan failed: HivePlatforms or local player missing")
        return nil
    end

    for _, platform in ipairs(hivePlatforms:GetChildren()) do
        local platformName = tostring(platform.Name or "")
        if string.find(platformName, "Platform", 1, true) then
            local playerRef = platform:FindFirstChild("PlayerRef")
            local refName = self:GetPlayerRefName(playerRef)
            self:HiveDebug("candidate=" .. platform:GetFullName() .. " playerRef=" .. tostring(refName))
            if refName == playerName then
                self:HiveDebug("matched hive=" .. platform:GetFullName())
                return platform
            end
        end
    end

    self:HiveDebug("no hive matched for " .. playerName)
    return nil
end

function UI:IsUnclaimedHiveRef(refName)
    local refText = tostring(refName or "")
    local lowerRef = string.lower(refText)

    if refText == "" then
        return true
    end

    if lowerRef == "nil" or lowerRef == "none" or lowerRef == "unclaimed" or lowerRef == "unreadable_name" then
        return true
    end

    return false
end

function UI:GetClaimableHivePlatform(localRoot)
    local hivePlatforms = workspace:FindFirstChild("HivePlatforms")
    if not hivePlatforms then
        self:HiveDebug("claim scan failed: HivePlatforms missing")
        return nil
    end

    local bestPlatform = nil
    local bestDistance = nil
    local rootPosition = localRoot and localRoot.Position or nil

    for _, platform in ipairs(hivePlatforms:GetChildren()) do
        local platformName = tostring(platform.Name or "")
        if string.find(platformName, "Platform", 1, true) then
            local playerRef = platform:FindFirstChild("PlayerRef")
            local refName = self:GetPlayerRefName(playerRef)

            if self:IsUnclaimedHiveRef(refName) then
                local platformObject = platform:FindFirstChild("Platform")
                local platformPart = self:GetBasePartFromObject(platformObject) or self:GetBasePartFromObject(platform)
                local distance = 0
                if platformPart and rootPosition then
                    distance = (platformPart.Position - rootPosition).Magnitude
                end

                self:HiveDebug(string.format(
                    "claim candidate=%s playerRef=%s distance=%.2f",
                    platform:GetFullName(),
                    tostring(refName),
                    distance
                ))

                if platformPart and (not bestDistance or distance < bestDistance) then
                    bestPlatform = platform
                    bestDistance = distance
                end
            else
                self:HiveDebug("claim skip=" .. platform:GetFullName() .. " playerRef=" .. tostring(refName))
            end
        end
    end

    if bestPlatform then
        self:HiveDebug("claim selected=" .. bestPlatform:GetFullName() .. " distance=" .. string.format("%.2f", bestDistance or 0))
    else
        self:HiveDebug("claim selected=none")
    end

    return bestPlatform
end

function UI:GetHiveTeleportPart(hivePlatform)
    if not hivePlatform then
        self:HiveDebug("teleport part failed: hivePlatform nil")
        return nil
    end

    local platformObject = hivePlatform:FindFirstChild("Platform")
    local platformPart = self:GetBasePartFromObject(platformObject)
    if platformPart then
        self:HiveDebug("using hive platform part=" .. platformPart:GetFullName())
        return platformPart
    end

    local fallbackPart = self:GetBasePartFromObject(hivePlatform)
    if fallbackPart then
        self:HiveDebug("using hive fallback part=" .. fallbackPart:GetFullName())
    else
        self:HiveDebug("teleport part failed: no BasePart found in " .. hivePlatform:GetFullName())
    end
    return fallbackPart
end

function UI:CheckHiveClaim(showNotification)
    local hivePlatform = self:GetOwnedHivePlatform()
    if hivePlatform then
        if showNotification then
            self:NotifyPlayer("Hive found: " .. tostring(hivePlatform.Name), "BSS", 3)
        end
        return hivePlatform
    end

    if showNotification then
