function UI:RefreshFieldOptions()
    local control = self:GetControl(2, "field_selection")
    if not control then
        return
    end

    local options = {"All"}
    local seen = {
        ["All"] = true,
    }

    local flowerZones = workspace:FindFirstChild("FlowerZones")
    if flowerZones then
        for _, zone in ipairs(flowerZones:GetChildren()) do
            local zoneName = tostring(zone.Name or "")
            if self:IsBrickFieldName(zoneName) and not seen[zoneName] then
                seen[zoneName] = true
                table.insert(options, zoneName)
            end
        end
    end

    local optionRank = {
        ["All"] = 1,
    }
    table.sort(options, function(a, b)
        local rankA = optionRank[a] or 3
        local rankB = optionRank[b] or 3
        if rankA ~= rankB then
            return rankA < rankB
        end
        return tostring(a) < tostring(b)
    end)

    local previousOptions = control.options or {}
    local changed = #previousOptions ~= #options
    if not changed then
        for index, option in ipairs(options) do
            if previousOptions[index] ~= option then
                changed = true
                break
            end
        end
    end

    control.options = options

    if not seen[tostring(control.value or "")] then
        control.value = "All"
        changed = true
    end

    if changed then
        self:MarkTabDirty(2)
        self:UpdateScrollLimit()
    end
end

