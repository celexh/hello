function UI:ClaimHiveIfNeeded(localRoot)
    local ownedHive = self:CheckHiveClaim(false)
    if ownedHive then
        return ownedHive
    end

    self:NotifyPlayer("No hive claimed; claiming one", "BSS", 3)
    self:HiveDebug("claim flow: no owned hive, waiting 3s")
    task.wait(3)

    ownedHive = self:CheckHiveClaim(false)
    if ownedHive then
        self:HiveDebug("claim flow: hive appeared during wait")
        return ownedHive
    end

    local claimPlatform = self:GetClaimableHivePlatform(localRoot)
    if not claimPlatform then
        self:NotifyPlayer("No unclaimed hive found", "BSS", 3)
        return nil
    end

    local platformPart = self:GetHiveTeleportPart(claimPlatform)
    if not platformPart then
        self:NotifyPlayer("Hive platform missing", "BSS", 3)
        return nil
    end

    local targetPosition = platformPart.Position + Vector3.new(0, 8, 0)
    local tweenSpeed = self:GetTweenSpeed()
    local tweenDistance = (targetPosition - localRoot.Position).Magnitude
    self:HiveDebug(string.format(
        "claim tween target=(%.2f, %.2f, %.2f) speed=%.2f distance=%.2f eta=%.2fs",
        targetPosition.X,
        targetPosition.Y,
        targetPosition.Z,
        tweenSpeed,
        tweenDistance,
        tweenDistance / math.max(tweenSpeed, 0.01)
    ))

    local tweenOk = self:SafeTweenPosition(localRoot, targetPosition, tweenSpeed)
    self:HiveDebug("claim tween finished result=" .. tostring(tweenOk))

    while true do
        ownedHive = self:CheckHiveClaim(false)
        if ownedHive then
            self:NotifyPlayer("Hive claimed", "BSS", 3)
            return ownedHive
        end

        if not self:PressInteractKey("hive claim") then
            return nil
        end
        task.wait(0.7)
    end
end

function UI:EnsureHiveClaimed()
    if self.hiveTweenRunning then
        self:HiveDebug("claim check ignored: hive action already running")
        return
    end

    self.hiveTweenRunning = true
    local ok, err = pcall(function()
        local ownedHive = self:CheckHiveClaim(true)
        if ownedHive then
            return
        end

        local localRoot = self:GetLocalRootPart()
        if not localRoot then
            self:HiveDebug("claim check failed: local root missing")
            self:NotifyPlayer("Hive claim failed", "BSS", 3)
            return
        end

        self:ClaimHiveIfNeeded(localRoot)
    end)
    self.hiveTweenRunning = false

    if not ok then
        self:HiveDebug("claim check error: " .. tostring(err))
        self:NotifyPlayer("Hive claim error", "BSS", 3)
    end
end

function UI:RunAsync(label, callback)
    local asyncLabel = tostring(label or "async")
    local function runner()
        local ok, err = pcall(callback)
        if not ok then
            self:HiveDebug(asyncLabel .. " error: " .. tostring(err))
            self:NotifyPlayer(asyncLabel .. " error", "BSS", 3)
        end
    end

    if task and type(task.spawn) == "function" then
        local spawnOk = pcall(function()
            task.spawn(runner)
        end)
        if spawnOk then
            return true
        end
    end

    if type(spawn) == "function" then
        local spawnOk = pcall(function()
            spawn(runner)
        end)
        if spawnOk then
            return true
        end
    end

    self:HiveDebug(asyncLabel .. " failed: no async runner available")
    self:NotifyPlayer(asyncLabel .. " failed", "BSS", 3)
    return false
end

function UI:TeleportToHive()
    if self.hiveTweenRunning then
        self:HiveDebug("Hive TP ignored: tween already running")
        self:NotifyPlayer("Hive TP already running", "BSS", 2)
        return
    end

    self.hiveTweenRunning = true
    self:HiveDebug("Hive TP start")
    local ok, err = pcall(function()
        local localRoot = self:GetLocalRootPart()
        if not localRoot then
            self:HiveDebug("failed: local root missing")
            self:NotifyPlayer("Hive TP failed", "BSS", 3)
            return
        end
        self:HiveDebug("local root=" .. localRoot:GetFullName())

        local hivePlatform = self:CheckHiveClaim(false)
        if not hivePlatform then
            self:HiveDebug("hive not claimed; starting claim flow")
            hivePlatform = self:ClaimHiveIfNeeded(localRoot)
            if not hivePlatform then
                self:HiveDebug("failed: hive not claimed after claim flow")
                self:NotifyPlayer("Hive not claimed", "BSS", 3)
                return
            end
        end

        local platformPart = self:GetHiveTeleportPart(hivePlatform)
        if not platformPart then
            self:HiveDebug("failed: hive platform part missing")
            self:NotifyPlayer("Hive platform missing", "BSS", 3)
            return
        end

        local targetPosition = platformPart.Position + Vector3.new(0, 8, 0)
        local tweenSpeed = self:GetTweenSpeed()
        local tweenDistance = (targetPosition - localRoot.Position).Magnitude
        self:HiveDebug(string.format(
            "tween target=(%.2f, %.2f, %.2f) speed=%.2f distance=%.2f eta=%.2fs",
            targetPosition.X,
            targetPosition.Y,
            targetPosition.Z,
            tweenSpeed,
            tweenDistance,
            tweenDistance / math.max(tweenSpeed, 0.01)
        ))

        local tweenOk = self:SafeTweenPosition(localRoot, targetPosition, tweenSpeed)
        self:HiveDebug("tween finished result=" .. tostring(tweenOk))
    end)

    self.hiveTweenRunning = false

    if not ok then
        self:HiveDebug("Hive TP error: " .. tostring(err))
        self:NotifyPlayer("Hive TP error", "BSS", 3)
    end
end

