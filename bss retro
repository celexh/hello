function UI:GetColor255(color)
    if not color then
        return 0, 0, 0
    end

    local r = color.R or 0
    local g = color.G or 0
    local b = color.B or 0
    if r <= 1 and g <= 1 and b <= 1 then
        r = r * 255
        g = g * 255
        b = b * 255
    end

    return math.clamp(math.floor(r + 0.5), 0, 255), math.clamp(math.floor(g + 0.5), 0, 255), math.clamp(math.floor(b + 0.5), 0, 255)
end

function UI:IsBuyableButton(buttonPart)
    if not buttonPart or not buttonPart:IsA("BasePart") then
        return false
    end

    local r, g, b = self:GetColor255(buttonPart.Color)
    return (r == 0 and g == 255 and b == 0) or (g >= 220 and r <= 60 and b <= 60)
end

