function UI:IsPositionInField(fieldName, position)
    local targetZone = self:GetFlowerZone(fieldName)
    if not targetZone or not targetZone:IsA("BasePart") or typeof(position) ~= "Vector3" then
        return false
    end

    local fieldPos = targetZone.Position
    local fieldSize = targetZone.Size
    local withinX = math.abs(position.X - fieldPos.X) <= fieldSize.X / 2
    local withinZ = math.abs(position.Z - fieldPos.Z) <= fieldSize.Z / 2
    local withinY = math.abs(position.Y - fieldPos.Y) <= 50
    return withinX and withinZ and withinY
end

